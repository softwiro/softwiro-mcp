       "examples": [
        "ف1",
        "ف2",
        "ف3"
       ],
       "allowed_values": {
        "from_range": "'الفصول'!$A$6:$A$205"
       }
      },
      {
       "column": "E",
       "header": "كود اللجنة",
       "kind": "input",
       "examples": [
        "L1",
        "L2",
        "L3"
       ],
       "allowed_values": {
        "from_range": "'اللجان'!$A$6:$A$205"
       }
      },
      {
       "column": "F",
       "header": "كود المراقب",
       "kind": "input",
       "examples": [
        "S01",
        "S02",
        "S03"
       ],
       "allowed_values": {
        "from_range": "'المراقبون'!$A$6:$A$205"
       }
      },
      {
       "column": "G",
       "header": "اسم المراقب",
       "kind": "formula",
       "formula_row_1": "=IF(F6&\"\"=\"\",\"\",IFERROR(INDEX('المراقبون'!$B$6:$B$205,MATCH(F6&\"\",'المراقبون'!$A$6:$A$205,0))&\"\",\"كود غير موجود\"))"
      },
      {
       "column": "H",
       "header": "طلاب الفصل",
       "kind": "formula",
       "formula_row_1": "=IF(D6&\"\"=\"\",\"\",IFERROR(INDEX('الفصول'!$C$6:$C$205,MATCH(D6&\"\",'الفصول'!$A$6:$A$205,0)),\"\"))"
      },
      {
       "column": "I",
       "header": "سعة اللجنة",
       "kind": "formula",
       "formula_row_1": "=IF(E6&\"\"=\"\",\"\",IFERROR(INDEX('اللجان'!$C$6:$C$205,MATCH(E6&\"\",'اللجان'!$A$6:$A$205,0)),\"\"))"
      },
      {
       "column": "J",
       "header": "تعارض طالب",
       "kind": "formula",
       "formula_row_1": "=IF(OR(NOT(AND(ISNUMBER(A6),B6&\"\"<>\"\",D6&\"\"<>\"\"))),\"\",IF(COUNTIFS($A$6:$A$405,A6&\"\",$B$6:$B$405,B6&\"\",$D$6:$D$405,D6&\"\")>1,\"تعارض\",\"\"))"
      },
      {
       "column": "K",
       "header": "تعارض لجنة",
       "kind": "formula",
       "formula_row_1": "=IF(OR(NOT(AND(ISNUMBER(A6),B6&\"\"<>\"\",E6&\"\"<>\"\"))),\"\",IF(COUNTIFS($A$6:$A$405,A6&\"\",$B$6:$B$405,B6&\"\",$E$6:$E$405,E6&\"\")>1,\"تعارض\",\"\"))"
      },
      {
       "column": "L",
       "header": "تعارض مراقب",
       "kind": "formula",
       "formula_row_1": "=IF(OR(NOT(AND(ISNUMBER(A6),B6&\"\"<>\"\",F6&\"\"<>\"\"))),\"\",IF(COUNTIFS($A$6:$A$405,A6&\"\",$B$6:$B$405,B6&\"\",$F$6:$F$405,F6&\"\")>1,\"تعارض\",\"\"))"
      },
      {
       "column": "M",
       "header": "سعة اللجنة",
       "kind": "formula",
       "formula_row_1": "=IF(AND(ISNUMBER(H6),ISNUMBER(I6)),IF(H6>I6,\"تجاوز\",\"\"),\"\")"
      },
      {
       "column": "N",
       "header": "عدد المشكلات",
       "kind": "formula",
       "formula_row_1": "=IF(A6=\"\",\"\",IF(J6=\"\",0,1)+IF(K6=\"\",0,1)+IF(L6=\"\",0,1)+IF(M6=\"\",0,1))"
      },
      {
       "column": "O",
       "header": "الحالة",
       "kind": "formula",
       "formula_row_1": "=IF(N6=\"\",\"\",IF(N6=0,\"سليم\",IF(N6>1,\"أكثر من مشكلة\",IF(J6<>\"\",\"تعارض طالب\",IF(K6<>\"\",\"تعارض لجنة\",IF(L6<>\"\",\"تعارض مراقب\",\"تجاوز السعة\"))))))"
      }
     ]
    }
   ]
