      {
       "column": "N",
       "header": "آخر دفعة",
       "kind": "formula",
       "formula_row_1": "=IF(C6&\"\"=\"\",\"\",IFERROR(SUMIFS('الدفعات'!$A$6:$A$2005,'الدفعات'!$B$6:$B$2005,A6&\"\",'الدفعات'!$G$6:$G$2005,1)/COUNTIFS('الدفعات'!$B$6:$B$2005,A6&\"\",'الدفعات'!$G$6:$G$2005,1),\"\"))"
