       "kind": "formula",
       "formula_row_1": "=IF(OR(C6&\"\"=\"\",NOT(ISNUMBER(F6)),NOT(ISNUMBER(H6))),\"\",MAX(0,(YEAR(IF(ISNUMBER(G6),MIN('الإعدادات'!$B$4,G6),'الإعدادات'!$B$4))-YEAR(F6))*12+MONTH(IF(ISNUMBER(G6),MIN('الإعدادات'!$B$4,G6),'الإعدادات'!$B$4))-MONTH(F6)+IF(DAY(IF(ISNUMBER(G6),MIN('الإعدادات'!$B$4,G6),'الإعدادات'!$B$4))>=H6,1,0)-IF(DAY(F6)>H6,1,0)))"
