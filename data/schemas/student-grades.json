      {
       "column": "M",
       "header": "التقدير",
       "kind": "formula",
       "formula_row_1": "=IF(L6=\"\",\"\",IFERROR(INDEX('الإعدادات'!$E$12:$E$19,MATCH(SMALL('الإعدادات'!$D$12:$D$19,COUNTIF('الإعدادات'!$D$12:$D$19,\"<=\"&ROUND(L6*100,2))),'الإعدادات'!$D$12:$D$19,0)),\"\"))"
