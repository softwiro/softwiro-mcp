       "formula_row_1": "=IF(OR($A6&\"\"<>\"\",$B6&\"\"<>\"\"),IF(OR(AND(ISNUMBER(C$3),NOT(ISNUMBER(C6))),AND(ISNUMBER(D$3),NOT(ISNUMBER(D6))),AND(ISNUMBER(E$3),NOT(ISNUMBER(E6))),AND(ISNUMBER(F$3),NOT(ISNUMBER(F6))),AND(ISNUMBER(G$3),NOT(ISNUMBER(G6))),AND(ISNUMBER(H$3),NOT(ISNUMBER(H6))),AND(ISNUMBER(I$3),NOT(ISNUMBER(I6))),AND(ISNUMBER(J$3),NOT(ISNUMBER(J6)))),1,0),\"\")"
      }
