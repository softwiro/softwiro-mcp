      {
       "column": "O",
       "header": "النتيجة",
       "kind": "formula",
       "formula_row_1": "=IF(L6=\"\",\"\",IF(ROUND(L6*100,2)<'الإعدادات'!$B$9,\"راسب\",\"ناجح\"))"
      },
      {
       "column": "P",
       "header": "ملاحظة",
       "kind": "formula",
       "formula_row_1": "=IF(Q6=\"\",\"\",TRIM(IF(Q6=1,\"درجة غير صحيحة\",\"\")&IF(AND(Q6=1,R6=1),\" · \",\"\")&IF(R6=1,\"درجات ناقصة\",\"\")))"
      },
      {
       "column": "Q",
       "header": "خطأ",
       "kind": "formula",
       "formula_row_1": "=IF(OR($A6&\"\"<>\"\",$B6&\"\"<>\"\"),IF(OR(IF(AND(ISNUMBER(C6),ISNUMBER(C$3)),OR(C6<0,C6>C$3),FALSE),IF(AND(ISNUMBER(D6),ISNUMBER(D$3)),OR(D6<0,D6>D$3),FALSE),IF(AND(ISNUMBER(E6),ISNUMBER(E$3)),OR(E6<0,E6>E$3),FALSE),IF(AND(ISNUMBER(F6),ISNUMBER(F$3)),OR(F6<0,F6>F$3),FALSE),IF(AND(ISNUMBER(G6),ISNUMBER(G$3)),OR(G6<0,G6>G$3),FALSE),IF(AND(ISNUMBER(H6),ISNUMBER(H$3)),OR(H6<0,H6>H$3),FALSE),IF(AND(ISNUMBER(I6),ISNUMBER(I$3)),OR(I6<0,I6>I$3),FALSE),IF(AND(ISNUMBER(J6),ISNUMBER(J$3)),OR(J6<0,J6>J$3),FALSE)),1,0),\"\")"
      },
      {
