      {
       "column": "G",
       "header": "الحصص المنفذة (محتسبة)",
       "kind": "formula",
       "formula_row_1": "=IF(A6&\"\"=\"\",\"\",SUMIFS('الدروس'!$J$6:$J$1005,'الدروس'!$A$6:$A$1005,A6&\"\"))"
      },
      {
       "column": "H",
       "header": "نسبة التغطية",
       "kind": "formula",
       "formula_row_1": "=IF(A6&\"\"=\"\",\"\",IF(F6=0,\"\",MIN(1,G6/F6)))"
      },
      {
       "column": "I",
       "header": "دروس متأخرة",
       "kind": "formula",
       "formula_row_1": "=IF(A6&\"\"=\"\",\"\",COUNTIFS('الدروس'!$A$6:$A$1005,A6&\"\",'الدروس'!$L$6:$L$1005,\"متأخر عن الخطة\"))"
      },
      {
       "column": "J",
       "header": "حصص متأخرة",
       "kind": "formula",
       "formula_row_1": "=IF(A6&\"\"=\"\",\"\",SUMIFS('الدروس'!$K$6:$K$1005,'الدروس'!$A$6:$A$1005,A6&\"\",'الدروس'!$L$6:$L$1005,\"متأخر عن الخطة\"))"
      },
      {
       "column": "K",
       "header": "الحالة",
       "kind": "formula",
       "formula_row_1": "=IF(A6&\"\"=\"\",\"\",IF(F6=0,\"لا دروس مسجلة\",IF(I6>0,\"متأخرة عن الخطة\",IF(G6>=F6,\"مكتملة\",IF(G6=0,\"لم تبدأ\",\"في الموعد\")))))"
      }
