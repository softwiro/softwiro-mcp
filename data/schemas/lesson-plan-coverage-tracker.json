       "header": "دروس تمت",
       "kind": "formula",
       "formula_row_1": "=IF(A6&\"\"=\"\",\"\",COUNTIFS('الدروس'!$A$6:$A$1005,A6&\"\",'الدروس'!$H$6:$H$1005,\"تم\"))"
