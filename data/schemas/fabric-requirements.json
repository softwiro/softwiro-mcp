       "column": "I",
       "header": "الاستهلاك بالمتر للقطعة",
       "kind": "formula",
       "formula_row_1": "=IF(OR(A5=\"\",C5=\"\",D5=\"\"),\"\",IF(D5>0,(C5+E5/100)/D5*(1+F5/100),\"\"))"
      },
      {
       "column": "J",
       "header": "وزن المتر (كيلو)",
       "kind": "formula",
       "formula_row_1": "=IF(OR(A5=\"\",G5=\"\",H5=\"\"),\"\",G5/100*H5/1000)"
      },
      {
       "column": "K",
       "header": "الاستهلاك بالكيلو للقطعة",
       "kind": "formula",
       "formula_row_1": "=IF(OR(I5=\"\",J5=\"\"),\"\",I5*J5)"
      }
     ]
    }
