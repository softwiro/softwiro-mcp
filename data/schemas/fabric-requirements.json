  },
  {
   "name": "الأوامر",
   "formula_cells": 1800,
   "record_tables": [
    {
     "header_row": 4,
     "first_record_row": 5,
     "sample_rows_filled": 4,
     "capacity_last_row": 304,
     "columns": [
      {
       "column": "A",
       "header": "رقم الأمر",
       "kind": "input",
       "examples": [
        "ق-101",
        "ق-102",
        "ق-103"
       ]
      },
      {
       "column": "B",
       "header": "الموديل",
       "kind": "input",
       "examples": [
        "تيشيرت بولو",
        "تيشيرت بولو",
        "ليجن نسائي"
       ],
       "allowed_values": {
        "from_range": "'الماركرات'!$A$5:$A$104"
       }
      },
      {
       "column": "C",
       "header": "الكمية",
       "kind": "input",
       "examples": [
        1000,
        400,
        600
       ]
      },
      {
       "column": "D",
       "header": "المرفوض (%)",
       "kind": "input",
       "examples": [
        3,
        2,
        4
       ]
      },
      {
       "column": "E",
       "header": "القماش",
       "kind": "formula",
       "formula_row_1": "=IF(B5=\"\",\"\",IFERROR(INDEX('الماركرات'!$B$5:$B$104,MATCH($B5,'الماركرات'!$A$5:$A$104,0))&\"\",\"\"))"
      },
      {
       "column": "F",
       "header": "القطع المطلوبة",
       "kind": "formula",
       "formula_row_1": "=IF(OR(B5=\"\",C5=\"\"),\"\",IF(D5<100,ROUNDUP(C5/(1-D5/100),0),\"\"))"
      },
      {
       "column": "G",
       "header": "الطبقات",
       "kind": "formula",
       "formula_row_1": "=IF(F5=\"\",\"\",IFERROR(ROUNDUP(F5/INDEX('الماركرات'!$D$5:$D$104,MATCH($B5,'الماركرات'!$A$5:$A$104,0)),0),\"\"))"
      },
      {
       "column": "H",
       "header": "القطع التي ستُقص",
       "kind": "formula",
       "formula_row_1": "=IF(G5=\"\",\"\",IFERROR(G5*INDEX('الماركرات'!$D$5:$D$104,MATCH($B5,'الماركرات'!$A$5:$A$104,0)),\"\"))"
      },
      {
       "column": "I",
       "header": "المتر المطلوب",
       "kind": "formula",
       "formula_row_1": "=IF(G5=\"\",\"\",IFERROR(G5*(INDEX('الماركرات'!$C$5:$C$104,MATCH($B5,'الماركرات'!$A$5:$A$104,0))+INDEX('الماركرات'!$E$5:$E$104,MATCH($B5,'الماركرات'!$A$5:$A$104,0))/100)*(1+INDEX('الماركرات'!$F$5:$F$104,MATCH($B5,'الماركرات'!$A$5:$A$104,0))/100),\"\"))"
      },
      {
       "column": "J",
       "header": "الكيلو المطلوب",
       "kind": "formula",
       "formula_row_1": "=IF(I5=\"\",\"\",IFERROR(I5*INDEX('الماركرات'!$J$5:$J$104,MATCH($B5,'الماركرات'!$A$5:$A$104,0)),\"\"))"
      }
     ]
    }
   ]
  },
