       "header": "المجموع المرجّح",
       "kind": "formula",
       "formula_row_1": "=IF(B6&\"\"=\"\",\"\",ROUND(IF(AND(ISNUMBER(C6),N('الإعدادات'!$C$8)>0),C6/'الإعدادات'!$C$8*N('الإعدادات'!$B$8),0)+IF(AND(ISNUMBER(D6),N('الإعدادات'!$C$9)>0),D6/'الإعدادات'!$C$9*N('الإعدادات'!$B$9),0)+IF(AND(ISNUMBER(E6),N('الإعدادات'!$C$10)>0),E6/'الإعدادات'!$C$10*N('الإعدادات'!$B$10),0)+IF(AND(ISNUMBER(F6),N('الإعدادات'!$C$11)>0),F6/'الإعدادات'!$C$11*N('الإعدادات'!$B$11),0),2))"
      },
      {
