       "header": "الوزن المرصود",
       "kind": "formula",
       "formula_row_1": "=IF(B6&\"\"=\"\",\"\",IF(AND(ISNUMBER(C6),N('الإعدادات'!$C$8)>0),N('الإعدادات'!$B$8),0)+IF(AND(ISNUMBER(D6),N('الإعدادات'!$C$9)>0),N('الإعدادات'!$B$9),0)+IF(AND(ISNUMBER(E6),N('الإعدادات'!$C$10)>0),N('الإعدادات'!$B$10),0)+IF(AND(ISNUMBER(F6),N('الإعدادات'!$C$11)>0),N('الإعدادات'!$B$11),0))"
      },
      {
       "column": "J",
       "header": "النسبة",
       "kind": "formula",
       "formula_row_1": "=IF(B6&\"\"=\"\",\"\",IF(N(I6)=0,\"\",H6/I6))"
      },
      {
       "column": "K",
       "header": "التقدير",
       "kind": "formula",
       "formula_row_1": "=IF(J6=\"\",\"\",INDEX('الإعدادات'!$B$19:$B$23,MATCH(J6,'الإعدادات'!$A$19:$A$23,1)))"
      },
      {
       "column": "L",
       "header": "الحالة",
       "kind": "formula",
       "formula_row_1": "=IF(J6=\"\",\"\",IF(J6<'الإعدادات'!$B$14,\"معرّض للرسوب\",IF(J6<'الإعدادات'!$B$14+'الإعدادات'!$B$15,\"على الحافة\",\"آمن\")))"
      },
      {
       "column": "M",
       "header": "ملاحظة",
       "kind": "formula",
       "formula_row_1": "=IF(B6&\"\"=\"\",\"\",IF(OR(AND(ISNUMBER(C6),OR(C6>N('الإعدادات'!$C$8),C6<0)),AND(ISNUMBER(D6),OR(D6>N('الإعدادات'!$C$9),D6<0)),AND(ISNUMBER(E6),OR(E6>N('الإعدادات'!$C$10),E6<0)),AND(ISNUMBER(F6),OR(F6>N('الإعدادات'!$C$11),F6<0))),\"درجة خارج الحد\",IF(G6<4,\"درجات ناقصة\",\"\")))"
      },
      {
       "column": "N",
       "header": "الترتيب",
       "kind": "formula",
       "formula_row_1": "=IF(J6=\"\",\"\",COUNTIFS($J$6:$J$205,\">\"&J6)+1)"
      },
      {
       "column": "O",
       "header": "ترتيب الخطر",
       "kind": "formula",
       "formula_row_1": "=IF(OR(L6=\"معرّض للرسوب\",L6=\"على الحافة\"),COUNTIFS($J$6:$J$205,\"<\"&J6,$L$6:$L$205,\"معرّض للرسوب\")+COUNTIFS($J$6:$J$205,\"<\"&J6,$L$6:$L$205,\"على الحافة\")+COUNTIFS($J$6:J6,J6,$L$6:L6,\"معرّض للرسوب\")+COUNTIFS($J$6:J6,J6,$L$6:L6,\"على الحافة\"),\"\")"
      }
     ]
    }
