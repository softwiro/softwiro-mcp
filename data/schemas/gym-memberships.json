       "formula_row_1": "=IF(OR(H6=\"ساري\",H6=\"ينتهي قريبًا\"),IF(M6=\"\",\"لم يحضر\",IF(N6>='الإعدادات'!$B$6,\"منقطع\",\"نشط\")),\"\")"
