       "header": "آخر حضور",
       "kind": "formula",
       "formula_row_1": "=IF(A6&\"\"=\"\",\"\",IFERROR(SUMIFS('الحضور'!$A$6:$A$2005,'الحضور'!$B$6:$B$2005,A6&\"\",'الحضور'!$D$6:$D$2005,1)/COUNTIFS('الحضور'!$B$6:$B$2005,A6&\"\",'الحضور'!$D$6:$D$2005,1),\"\"))"
      },
      {
