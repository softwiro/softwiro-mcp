       "header": "عدد الاشتراكات",
       "kind": "formula",
       "formula_row_1": "=IF(A6&\"\"=\"\",\"\",COUNTIFS('الاشتراكات'!$B$6:$B$1005,A6&\"\"))"
      },
      {
       "column": "F",
       "header": "تاريخ انتهاء الاشتراك",
       "kind": "formula",
       "formula_row_1": "=IF(A6&\"\"=\"\",\"\",IFERROR(SUMIFS('الاشتراكات'!$I$6:$I$1005,'الاشتراكات'!$B$6:$B$1005,A6&\"\",'الاشتراكات'!$J$6:$J$1005,1)/COUNTIFS('الاشتراكات'!$B$6:$B$1005,A6&\"\",'الاشتراكات'!$J$6:$J$1005,1),\"\"))"
      },
      {
       "column": "G",
       "header": "أيام حتى الانتهاء",
       "kind": "formula",
       "formula_row_1": "=IF(F6=\"\",\"\",F6-'الإعدادات'!$B$4)"
      },
      {
       "column": "H",
       "header": "الحالة",
       "kind": "formula",
       "formula_row_1": "=IF(A6&\"\"=\"\",\"\",IF(F6=\"\",\"بدون اشتراك\",IF(G6<0,\"منتهي\",IF(G6<='الإعدادات'!$B$5,\"ينتهي قريبًا\",\"ساري\"))))"
      },
      {
       "column": "I",
       "header": "قيمة الاشتراكات",
       "kind": "formula",
       "formula_row_1": "=IF(A6&\"\"=\"\",\"\",SUMIFS('الاشتراكات'!$G$6:$G$1005,'الاشتراكات'!$B$6:$B$1005,A6&\"\"))"
      },
      {
       "column": "J",
       "header": "المدفوع",
       "kind": "formula",
       "formula_row_1": "=IF(A6&\"\"=\"\",\"\",SUMIFS('الدفعات'!$C$6:$C$2005,'الدفعات'!$B$6:$B$2005,A6&\"\"))"
      },
      {
       "column": "K",
       "header": "المتبقي",
       "kind": "formula",
       "formula_row_1": "=IF(A6&\"\"=\"\",\"\",ROUND(I6-J6,2))"
      },
      {
       "column": "L",
       "header": "زيارات آخر 30 يومًا",
       "kind": "formula",
       "formula_row_1": "=IF(A6&\"\"=\"\",\"\",COUNTIFS('الحضور'!$B$6:$B$2005,A6&\"\",'الحضور'!$A$6:$A$2005,\">=\"&('الإعدادات'!$B$4-29),'الحضور'!$A$6:$A$2005,\"<=\"&'الإعدادات'!$B$4))"
      },
      {
