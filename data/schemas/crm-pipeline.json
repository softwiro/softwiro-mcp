       "header": "الاحتمال",
       "kind": "formula",
       "formula_row_1": "=IF(C6&\"\"=\"\",\"\",IFERROR(VLOOKUP(C6,'الإعدادات'!$A$8:$B$13,2,FALSE),\"\"))"
      },
      {
       "column": "I",
       "header": "القيمة الموزونة",
       "kind": "formula",
       "formula_row_1": "=IF(OR(H6=\"\",NOT(ISNUMBER(D6))),\"\",ROUND(D6*H6,2))"
      },
      {
       "column": "J",
       "header": "حالة المتابعة",
       "kind": "formula",
       "formula_row_1": "=IF(A6&\"\"=\"\",\"\",IF(OR(C6=\"تم\",C6=\"خسارة\"),\"مغلقة\",IF(NOT(ISNUMBER(E6)),\"بلا موعد\",IF(E6<'الإعدادات'!$B$4,\"متأخرة\",IF(E6='الإعدادات'!$B$4,\"اليوم\",\"قادمة\")))))"
      },
      {
       "column": "K",
       "header": "أيام التأخير",
       "kind": "formula",
       "formula_row_1": "=IF(OR(J6=\"متأخرة\",J6=\"اليوم\"),'الإعدادات'!$B$4-E6,\"\")"
      },
      {
       "column": "L",
       "header": "أيام منذ آخر تواصل",
       "kind": "formula",
       "formula_row_1": "=IF(OR(A6&\"\"=\"\",NOT(ISNUMBER(F6))),\"\",'الإعدادات'!$B$4-F6)"
      },
      {
       "column": "M",
       "header": "ترتيب المتابعة",
       "kind": "formula",
       "formula_row_1": "=IF(OR(J6=\"متأخرة\",J6=\"اليوم\"),COUNTIFS($J$6:$J$505,\"متأخرة\",$E$6:$E$505,\"<\"&E6)+COUNTIFS($J$6:$J$505,\"اليوم\",$E$6:$E$505,\"<\"&E6)+COUNTIFS($E$6:E6,E6&\"\",$J$6:J6,J6),\"\")"
      }
     ]
    }
   ]
