       "kind": "formula",
       "formula_row_1": "=IF(A6&\"\"=\"\",\"\",IF(SUMIFS('المراحل'!$C$6:$C$1005,'المراحل'!$A$6:$A$1005,A6&\"\")=0,\"\",SUMIFS('المراحل'!$F$6:$F$1005,'المراحل'!$A$6:$A$1005,A6&\"\")/SUMIFS('المراحل'!$C$6:$C$1005,'المراحل'!$A$6:$A$1005,A6&\"\")))"
