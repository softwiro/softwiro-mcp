       "header": "المحصّل من العميل",
       "kind": "formula",
       "formula_row_1": "=IF(A6&\"\"=\"\",\"\",ROUND(SUMIFS('الدفعات'!$C$6:$C$1005,'الدفعات'!$B$6:$B$1005,A6&\"\"),2))"
      },
      {
