       "header": "المستحق على العميل",
       "kind": "formula",
       "formula_row_1": "=IF(OR(A6&\"\"=\"\",NOT(ISNUMBER(D6))),\"\",MAX(0,ROUND(D6*N(I6)-M6,2)))"
      },
      {
       "column": "O",
       "header": "المتبقي من العقد",
       "kind": "formula",
       "formula_row_1": "=IF(OR(A6&\"\"=\"\",NOT(ISNUMBER(D6))),\"\",ROUND(D6-M6,2))"
      },
      {
       "column": "P",
       "header": "أيام التأخر",
       "kind": "formula",
       "formula_row_1": "=IF(OR(A6&\"\"=\"\",NOT(ISNUMBER(G6))),\"\",IF(ISNUMBER(H6),MAX(0,H6-G6),MAX(0,'الإعدادات'!$B$4-G6)))"
