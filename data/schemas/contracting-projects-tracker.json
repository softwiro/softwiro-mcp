       "header": "نسبة صرف الميزانية",
       "kind": "formula",
       "formula_row_1": "=IF(OR(J6=\"\",N(E6)=0),\"\",J6/E6)"
      },
      {
       "column": "L",
       "header": "الربح المتوقع",
       "kind": "formula",
       "formula_row_1": "=IF(OR(A6&\"\"=\"\",NOT(ISNUMBER(D6))),\"\",ROUND(D6-MAX(N(E6),J6),2))"
