       "header": "الأشهر المستحقة",
       "kind": "formula",
       "formula_row_1": "=IF(OR(A6&\"\"=\"\",NOT(ISNUMBER(E6)),NOT(ISNUMBER(D6))),\"\",MAX(0,(YEAR(IF(ISNUMBER(F6),MIN('الإعدادات'!$B$4,F6),'الإعدادات'!$B$4))-YEAR(E6))*12+MONTH(IF(ISNUMBER(F6),MIN('الإعدادات'!$B$4,F6),'الإعدادات'!$B$4))-MONTH(E6)+IF(DAY(IF(ISNUMBER(F6),MIN('الإعدادات'!$B$4,F6),'الإعدادات'!$B$4))>=DAY(E6),1,0)))"
      },
      {
       "column": "I",
       "header": "إجمالي المستحق",
       "kind": "formula",
       "formula_row_1": "=IF(H6=\"\",\"\",ROUND(H6*D6,2))"
      },
      {
       "column": "J",
       "header": "المدفوع",
       "kind": "formula",
       "formula_row_1": "=IF(A6&\"\"=\"\",\"\",SUMIFS('الدفعات'!$C$6:$C$1005,'الدفعات'!$B$6:$B$1005,A6&\"\"))"
      },
      {
       "column": "K",
       "header": "المتبقي",
       "kind": "formula",
       "formula_row_1": "=IF(I6=\"\",\"\",ROUND(I6-J6,2))"
      },
