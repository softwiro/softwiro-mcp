       "header": "أيام حتى النهاية",
       "kind": "formula",
       "formula_row_1": "=IF(OR(A6&\"\"=\"\",NOT(ISNUMBER(F6))),\"\",F6-'الإعدادات'!$B$4)"
      },
      {
       "column": "M",
       "header": "حالة العقد",
       "kind": "formula",
       "formula_row_1": "=IF(A6&\"\"=\"\",\"\",IF(OR(NOT(ISNUMBER(E6)),NOT(ISNUMBER(F6))),\"بيانات ناقصة\",IF(F6<'الإعدادات'!$B$4,\"منتهي\",IF(E6>'الإعدادات'!$B$4,\"لم يبدأ\",IF(F6-'الإعدادات'!$B$4<='الإعدادات'!$B$5,\"ينتهي قريبًا\",\"ساري\")))))"
      },
      {
       "column": "N",
       "header": "القيمة السنوية",
       "kind": "formula",
       "formula_row_1": "=IF(N(D6)=0,\"\",ROUND(D6*12,2))"
      },
      {
       "column": "O",
       "header": "ترتيب التجديد",
       "kind": "formula",
       "formula_row_1": "=IF(OR(M6=\"منتهي\",M6=\"ينتهي قريبًا\"),COUNTIFS($M$6:$M$205,\"منتهي\",$L$6:$L$205,\"<\"&L6)+COUNTIFS($M$6:$M$205,\"ينتهي قريبًا\",$L$6:$L$205,\"<\"&L6)+COUNTIFS($M$6:M6,\"منتهي\",$L$6:L6,L6)+COUNTIFS($M$6:M6,\"ينتهي قريبًا\",$L$6:L6,L6),\"\")"
      }
     ]
    }
