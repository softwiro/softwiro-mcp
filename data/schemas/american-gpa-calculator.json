       "column": "K",
       "header": "الحالة",
       "kind": "formula",
       "formula_row_1": "=IF(AND(A6&\"\"=\"\",B6&\"\"=\"\",C6&\"\"=\"\",D6&\"\"=\"\",E6&\"\"=\"\"),\"\",IF(NOT(ISNUMBER(A6)),\"السنة ناقصة\",IF(NOT(ISNUMBER(C6)),\"الكريديت ناقص\",IF(C6<=0,\"الكريديت ناقص\",IF(E6&\"\"=\"\",\"بدون تقدير\",IF(F6=\"\",\"تقدير غير موجود\",IF(G6=\"\",\"نوع غير موجود\",\"محسوب\")))))))"
