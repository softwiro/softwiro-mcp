       "header": "نقاط مرجّحة",
       "kind": "formula",
       "formula_row_1": "=IF(OR(F6=\"\",G6=\"\"),\"\",IF(F6>'الإعدادات'!$B$5,ROUND(F6+G6,4),F6))"
