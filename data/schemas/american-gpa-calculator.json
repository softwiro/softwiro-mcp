       "header": "جودة غير مرجّحة",
       "kind": "formula",
       "formula_row_1": "=IF(K6=\"محسوب\",ROUND(C6*F6,4),\"\")"
      },
      {
       "column": "J",
       "header": "جودة مرجّحة",
       "kind": "formula",
       "formula_row_1": "=IF(K6=\"محسوب\",ROUND(C6*H6,4),\"\")"
      },
