      },
      {
       "column": "E",
       "header": "الانحراف (ميزانية - فعلي)",
       "kind": "formula",
       "formula_row_1": "=IF($A6=\"\",\"\",C6-D6)"
      },
      {
       "column": "F",
       "header": "نسبة الصرف",
       "kind": "formula",
       "formula_row_1": "=IF($A6=\"\",\"\",IF(C6=0,\"\",D6/C6))"
      },
      {
       "column": "G",
       "header": "الحالة",
       "kind": "formula",
       "formula_row_1": "=IF($A6=\"\",\"\",IF(AND(C6=0,D6=0),\"-\",IF(D6>C6,\"تجاوز الميزانية\",IF(AND(C6>0,D6/C6>='الإعدادات'!$B$7),\"قريب من الحد\",\"ضمن الميزانية\"))))"
      }
     ]
    }
