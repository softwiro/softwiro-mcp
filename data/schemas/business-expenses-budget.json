       "header": "ميزانية الفترة",
       "kind": "formula",
       "formula_row_1": "=IF($A6=\"\",\"\",SUMIFS('الميزانية الشهرية'!$B6:$M6,'الميزانية الشهرية'!$B$4:$M$4,\">=\"&'الإعدادات'!$B$5,'الميزانية الشهرية'!$B$4:$M$4,\"<=\"&'الإعدادات'!$B$6))"
