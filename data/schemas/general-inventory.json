       "header": "هامش الربح",
       "kind": "formula",
       "formula_row_1": "=IF(A6&\"\"=\"\",\"\",IF(N(E6)>0,(E6-D6)/E6,\"\"))"
      },
      {
       "column": "M",
       "header": "الربح المتوقع للرصيد",
       "kind": "formula",
       "formula_row_1": "=IF(A6&\"\"=\"\",\"\",ROUND(I6*K6,2))"
      },
      {
