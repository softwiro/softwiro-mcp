       "kind": "formula",
       "formula_row_1": "=IF(A6&\"\"=\"\",\"\",SUMIFS('الحركات'!$C$6:$C$1505,'الحركات'!$B$6:$B$1505,A6&\"\",'الحركات'!$D$6:$D$1505,\"منصرف\"))"
