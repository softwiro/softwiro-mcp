       "column": "J",
       "header": "قيمة المخزون (شراء)",
       "kind": "formula",
       "formula_row_1": "=IF(A6&\"\"=\"\",\"\",ROUND(I6*N(D6),2))"
      },
      {
       "column": "K",
       "header": "ربح الوحدة",
       "kind": "formula",
       "formula_row_1": "=IF(A6&\"\"=\"\",\"\",E6-D6)"
