       "header": "آخر حركة",
       "kind": "formula",
       "formula_row_1": "=IF(A6&\"\"=\"\",\"\",IFERROR(SUMIFS('الحركات'!$A$6:$A$1505,'الحركات'!$B$6:$B$1505,A6&\"\",'الحركات'!$G$6:$G$1505,1)/COUNTIFS('الحركات'!$B$6:$B$1505,A6&\"\",'الحركات'!$G$6:$G$1505,1),\"\"))"
      },
      {
       "column": "O",
       "header": "أيام بلا حركة",
       "kind": "formula",
       "formula_row_1": "=IF(OR(A6&\"\"=\"\",N6=\"\"),\"\",'الإعدادات'!$B$4-N6)"
      },
      {
       "column": "P",
       "header": "الحالة",
       "kind": "formula",
       "formula_row_1": "=IF(A6&\"\"=\"\",\"\",IF(N6=\"\",\"بلا حركة\",IF(I6<=0,\"نفد\",IF(I6<N(F6),\"اطلب\",\"متوفر\"))))"
      },
      {
       "column": "Q",
       "header": "راكد؟",
       "kind": "formula",
       "formula_row_1": "=IF(OR(A6&\"\"=\"\",O6=\"\",N(I6)<=0),\"\",IF(O6>='الإعدادات'!$B$5,\"راكد\",\"\"))"
      },
      {
       "column": "R",
       "header": "كمية الطلب المقترحة",
       "kind": "formula",
       "formula_row_1": "=IF(OR(P6=\"نفد\",P6=\"اطلب\"),MAX(0,ROUNDUP(N(F6)*'الإعدادات'!$B$6-I6,0)),\"\")"
      },
      {
       "column": "S",
