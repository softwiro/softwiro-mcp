      {
       "column": "F",
       "header": "الأيام إلى الامتحان",
       "kind": "formula",
       "formula_row_1": "=IF(A6&\"\"=\"\",\"\",IFERROR(IF(INDEX('المواد'!$B$6:$B$20,MATCH(A6,'المواد'!$A$6:$A$20,0))>0,INDEX('المواد'!$B$6:$B$20,MATCH(A6,'المواد'!$A$6:$A$20,0))-'الإعدادات'!$B$4,\"\"),\"\"))"
      },
      {
       "column": "G",
       "header": "الأيام منذ آخر مذاكرة",
       "kind": "formula",
       "formula_row_1": "=IF(OR(A6&\"\"=\"\",E6&\"\"=\"\"),\"\",'الإعدادات'!$B$4-E6)"
      },
      {
       "column": "H",
       "header": "يحتاج مراجعة",
       "kind": "formula",
       "formula_row_1": "=IF(A6&\"\"=\"\",\"\",IF(OR(AND(ISNUMBER(D6),D6>=0,D6<=10,D6<$B$4),AND(C6=\"ذاكرته\",ISNUMBER(F6),F6>=0,F6<=7)),\"نعم\",\"\"))"
      },
      {
       "column": "I",
       "header": "تنبيه",
       "kind": "formula",
       "formula_row_1": "=IF(A6&B6=\"\",\"\",IF(A6&\"\"=\"\",\"اختر المادة\",IF(ISNUMBER(MATCH(A6,'المواد'!$A$6:$A$20,0)),IF(AND(D6&\"\"<>\"\",OR(NOT(ISNUMBER(D6)),D6<0,D6>10)),\"الدرجة من 0 إلى 10\",IF(C6&\"\"=\"\",\"اختر الحالة\",\"\")),\"المادة غير موجودة\")))"
      },
      {
       "column": "J",
       "header": "مفتاح الترتيب (مساعد)",
       "kind": "formula",
       "formula_row_1": "=IF(AND(A6&\"\"<>\"\",ISNUMBER(D6),D6>=0,D6<=10),D6+ROW()/100000,\"\")"
      }
     ]
    }
