     "sample_rows_filled": 0,
     "capacity_last_row": 34,
     "columns": [
      {
       "column": "A",
       "header": "المادة",
       "kind": "formula",
       "formula_row_1": "=IF('المواد'!A6&\"\"=\"\",\"\",'المواد'!A6)"
      },
      {
       "column": "B",
       "header": "إجمالي الدروس",
       "kind": "formula",
       "formula_row_1": "=IF(A6=\"\",\"\",COUNTIF('الدروس'!$A$6:$A$505,A6))"
      },
      {
       "column": "C",
       "header": "ما ذاكرته",
       "kind": "formula",
       "formula_row_1": "=IF(A6=\"\",\"\",COUNTIFS('الدروس'!$A$6:$A$505,A6,'الدروس'!$C$6:$C$505,\"ذاكرته\")+COUNTIFS('الدروس'!$A$6:$A$505,A6,'الدروس'!$C$6:$C$505,\"راجعته\"))"
      },
      {
       "column": "D",
       "header": "ما راجعته",
       "kind": "formula",
       "formula_row_1": "=IF(A6=\"\",\"\",COUNTIFS('الدروس'!$A$6:$A$505,A6,'الدروس'!$C$6:$C$505,\"راجعته\"))"
      },
      {
       "column": "E",
       "header": "نسبة الإنجاز",
       "kind": "formula",
       "formula_row_1": "=IF(A6=\"\",\"\",IF(B6=0,\"\",C6/B6))"
      },
      {
       "column": "F",
       "header": "متوسط الدرجات",
       "kind": "formula",
       "formula_row_1": "=IF(A6=\"\",\"\",IF(COUNTIFS('الدروس'!$A$6:$A$505,A6,'الدروس'!$D$6:$D$505,\">=0\",'الدروس'!$D$6:$D$505,\"<=10\")=0,\"\",AVERAGEIFS('الدروس'!$D$6:$D$505,'الدروس'!$A$6:$A$505,A6,'الدروس'!$D$6:$D$505,\">=0\",'الدروس'!$D$6:$D$505,\"<=10\")))"
      },
      {
       "column": "G",
       "header": "دروس ضعيفة",
       "kind": "formula",
       "formula_row_1": "=IF(A6=\"\",\"\",COUNTIFS('الدروس'!$A$6:$A$505,A6,'الدروس'!$D$6:$D$505,\">=0\",'الدروس'!$D$6:$D$505,\"<\"&'الإعدادات'!$B$6))"
      },
      {
       "column": "H",
       "header": "الأيام إلى الامتحان",
       "kind": "formula",
       "formula_row_1": "=IF(A6=\"\",\"\",IF(ISNUMBER('المواد'!B6),'المواد'!B6-'الإعدادات'!$B$4,\"\"))"
      },
      {
       "column": "I",
       "header": "الدروس المتبقية",
       "kind": "formula",
       "formula_row_1": "=IF(A6=\"\",\"\",B6-C6)"
      },
      {
       "column": "J",
       "header": "دروس لازمة يوميًا",
       "kind": "formula",
       "formula_row_1": "=IF(OR(A6=\"\",H6=\"\"),\"\",IF(H6<=0,\"انتهى\",ROUND(I6/H6,2)))"
      },
      {
       "column": "K",
       "header": "الحالة",
       "kind": "formula",
       "formula_row_1": "=IF(OR(A6=\"\",H6=\"\"),\"\",IF(H6<=0,\"انتهى الامتحان\",IF(I6/H6>'الإعدادات'!$B$5,\"متأخر\",IF(I6/H6>0.7*'الإعدادات'!$B$5,\"انتبه\",\"على المسار\"))))"
      }
     ]
    }
   ]
