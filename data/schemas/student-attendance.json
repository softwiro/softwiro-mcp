     "columns": [
      {
       "column": "AH",
       "header": "حاضر",
       "kind": "formula",
       "formula_row_1": "=IF($B6=\"\",\"\",COUNTIF($C6:$AG6,\"ح\"))"
      },
      {
       "column": "AI",
       "header": "غائب",
       "kind": "formula",
       "formula_row_1": "=IF($B6=\"\",\"\",COUNTIF($C6:$AG6,\"غ\"))"
      },
      {
       "column": "AJ",
       "header": "متأخر",
       "kind": "formula",
       "formula_row_1": "=IF($B6=\"\",\"\",COUNTIF($C6:$AG6,\"ت\"))"
      },
      {
       "column": "AK",
       "header": "بعذر",
       "kind": "formula",
       "formula_row_1": "=IF($B6=\"\",\"\",COUNTIF($C6:$AG6,\"ع\"))"
      },
      {
       "column": "AL",
       "header": "الأيام المسجلة",
       "kind": "formula",
       "formula_row_1": "=IF($B6=\"\",\"\",AH6+AI6+AJ6+AK6)"
      },
      {
       "column": "AM",
       "header": "نسبة الحضور",
       "kind": "formula",
       "formula_row_1": "=IF($B6=\"\",\"\",IF(AL6=0,\"\",(AH6+AJ6)/AL6))"
      },
      {
       "column": "AN",
       "header": "الحالة",
       "kind": "formula",
       "formula_row_1": "=IF($B6=\"\",\"\",IF(AI6>='الإعدادات'!$B$7,\"تجاوز حد الغياب\",IF(AND('الإعدادات'!$B$7>1,AI6>='الإعدادات'!$B$7-1),\"قريب من الحد\",\"منتظم\")))"
      }
     ]
    }
   ]
  },
  {
