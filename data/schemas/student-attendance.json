       "formula_row_1": "=IFERROR(IF(INDEX('الحضور'!$AI$6:$AI$65,MATCH($A14,'الحضور'!$AO$6:$AO$65,0))=0,\"\",INDEX('الحضور'!$B$6:$B$65,MATCH($A14,'الحضور'!$AO$6:$AO$65,0))),\"\")"
      },
      {
       "column": "C",
       "header": "أيام الغياب (غ)",
       "kind": "formula",
       "formula_row_1": "=IFERROR(IF(INDEX('الحضور'!$AI$6:$AI$65,MATCH($A14,'الحضور'!$AO$6:$AO$65,0))=0,\"\",INDEX('الحضور'!$AI$6:$AI$65,MATCH($A14,'الحضور'!$AO$6:$AO$65,0))),\"\")"
      },
      {
       "column": "D",
       "header": "الحالة",
       "kind": "formula",
       "formula_row_1": "=IF(B14=\"\",\"\",INDEX('الحضور'!$AN$6:$AN$65,MATCH($A14,'الحضور'!$AO$6:$AO$65,0)))"
      }
     ]
    }
   ],
