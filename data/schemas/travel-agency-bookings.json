       "header": "أيام حتى السفر",
       "kind": "formula",
       "formula_row_1": "=IF(OR(A6&\"\"=\"\",NOT(ISNUMBER(G6))),\"\",G6-'الإعدادات'!$B$4)"
      },
      {
       "column": "S",
       "header": "تنبيه",
       "kind": "formula",
       "formula_row_1": "=IF(OR(R6=\"\",K6=\"ملغي\"),\"\",IF(N(P6)<=0,\"\",IF(R6<0,\"سافر وعليه متبقي\",IF(R6<='الإعدادات'!$B$5,\"سفر قريب ومتبقي\",\"\"))))"
      },
