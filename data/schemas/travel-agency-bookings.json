       "kind": "formula",
       "formula_row_1": "=IF(OR(A6&\"\"=\"\",NOT(ISNUMBER(H6)),NOT(ISNUMBER(I6))),\"\",IF(K6=\"ملغي\",0,ROUND(H6*I6,2)))"
      },
      {
