       "kind": "formula",
       "formula_row_1": "=IF(ISNUMBER(P6),IF(P6>0,COUNTIFS($P$6:$P$1005,\">\"&P6)+COUNTIFS($P$6:P6,P6),\"\"),\"\")"
      }
     ]
