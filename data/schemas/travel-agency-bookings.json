       "header": "حالة السداد",
       "kind": "formula",
       "formula_row_1": "=IF(A6&\"\"=\"\",\"\",IF(L6=\"\",\"بيانات ناقصة\",IF(K6=\"ملغي\",IF(O6>0,\"ملغي - يُراجع المدفوع\",\"ملغي\"),IF(P6>0,IF(O6=0,\"لم يدفع\",\"دفع جزءًا\"),IF(P6<0,\"مدفوع زيادة\",\"مسدد\")))))"
