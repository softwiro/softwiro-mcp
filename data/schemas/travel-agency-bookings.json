       "header": "المدفوع",
       "kind": "formula",
       "formula_row_1": "=IF(A6&\"\"=\"\",\"\",SUMIFS('الدفعات'!$C$6:$C$2005,'الدفعات'!$B$6:$B$2005,A6&\"\"))"
      },
      {
       "column": "P",
       "header": "المتبقي",
       "kind": "formula",
       "formula_row_1": "=IF(L6=\"\",\"\",IF(K6=\"ملغي\",\"\",ROUND(L6-O6,2)))"
