      },
      {
       "column": "I",
       "header": "الحالة",
       "kind": "formula",
       "formula_row_1": "=IF(G6=\"\",\"\",IF(E6=0,\"تحقق\",IF(C6<'الإعدادات'!$B$4,\"فات الموعد\",\"جارٍ\")))"
