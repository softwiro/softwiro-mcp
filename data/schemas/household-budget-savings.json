       "formula_row_1": "=IF(OR(A6&\"\"=\"\",NOT(ISNUMBER(B6))),\"\",MAX(0,ROUND(B6-N(D6),2)))"
      },
      {
       "column": "F",
       "header": "نسبة الإنجاز",
       "kind": "formula",
       "formula_row_1": "=IF(OR(E6=\"\",N(B6)=0),\"\",MIN(1,N(D6)/B6))"
      },
      {
       "column": "G",
       "header": "الأشهر المتبقية",
       "kind": "formula",
       "formula_row_1": "=IF(OR(E6=\"\",NOT(ISNUMBER(C6))),\"\",IF(E6=0,0,MAX(1,(YEAR(C6)-YEAR('الإعدادات'!$B$4))*12+MONTH(C6)-MONTH('الإعدادات'!$B$4))))"
