       "kind": "formula",
       "formula_row_1": "=IF(A6&\"\"=\"\",\"\",ROUND(N(C6)-D6,2))"
      },
      {
       "column": "F",
       "header": "نسبة الصرف",
       "kind": "formula",
       "formula_row_1": "=IF(OR(A6&\"\"=\"\",N(C6)=0),\"\",D6/C6)"
      },
      {
       "column": "G",
       "header": "الحالة",
       "kind": "formula",
       "formula_row_1": "=IF(A6&\"\"=\"\",\"\",IF(D6=0,\"لم يُصرف\",IF(N(C6)=0,\"بدون ميزانية\",IF(D6>C6,\"تجاوز\",\"ضمن الميزانية\"))))"
      },
      {
       "column": "H",
       "header": "ترتيب الصرف",
       "kind": "formula",
       "formula_row_1": "=IF(ISNUMBER(D6),IF(D6>0,COUNTIFS($D$6:$D$45,\">\"&D6)+COUNTIFS($D$6:D6,D6),\"\"),\"\")"
      }
     ]
    }
