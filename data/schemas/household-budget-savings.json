       "kind": "formula",
       "formula_row_1": "=IF(A6&\"\"=\"\",\"\",ROUND(SUMIFS('المصروفات'!$D$6:$D$2005,'المصروفات'!$B$6:$B$2005,A6&\"\",'المصروفات'!$A$6:$A$2005,\">=\"&'الإعدادات'!$B$6,'المصروفات'!$A$6:$A$2005,\"<\"&'الإعدادات'!$B$7),2))"
